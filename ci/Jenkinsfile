
pipeline {
    agent none

    stages {
        stage('Tests Python') {
            agent {
                label 'python-agent'
            }

            steps {
                checkout scm

                dir('apps/demo-api') {
                    sh '''
                        python3 -m venv .venv-ci
                        .venv-ci/bin/python -m pip install -r requirements.txt
                        .venv-ci/bin/python -m pytest -v
                    '''
                }
            }
        }

        stage('Docker Build') {
            agent {
                label 'docker-agent'
            }

            steps {
                checkout scm

                dir('apps/demo-api') {
                    sh '''
                        docker build -t cloudsecops-demo:v2 .
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'CloudSecOps AI - Pipeline SUCCESS'
        }

        failure {
            echo 'CloudSecOps AI - Pipeline FAILED'
        }
    }
}
