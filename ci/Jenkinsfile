
pipeline {
    agent {
        label 'python-agent'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup Python') {
            steps {
                dir('apps/demo-api') {
                    sh '''
                        python3 -m venv .venv-ci
                        .venv-ci/bin/python -m pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('apps/demo-api') {
                    sh '.venv-ci/bin/python -m pytest -v'
                }
            }
        }
    }

    post {
        success {
            echo 'CloudSecOps AI - Tests passed!'
        }

        failure {
            echo 'CloudSecOps AI - Pipeline failed!'
        }
    }
}
